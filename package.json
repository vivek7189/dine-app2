{
  "name": "dine-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --platform android",
    "build:android": "expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "build:apk": "expo run:android --variant release",
    "build:apk-simple": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
