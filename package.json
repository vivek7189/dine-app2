    "@react-navigation/native-stack": "^6.9.17",
    "@types/react": "~19.1.10",
    "axios": "^1.12.2",
    "expo": "^54.0.31",
    "expo-av": "~16.0.8",
    "expo-font": "~14.0.10",
    "expo-linking": "~8.0.11",
    "expo-modules-core": "~3.0.29",
    "expo-router": "~6.0.21",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "^31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
