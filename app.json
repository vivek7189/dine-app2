{
  "expo": {
    "name": "DineOpen Staff",
    "slug": "dine-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dineopen.waiter",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs access to microphone for voice order taking.",
        "NSSpeechRecognitionUsageDescription": "This app needs speech recognition for voice order taking."
      }
    },
    "android": {
      "package": "com.dineopen.waiter",
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "dineopen",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dcfa8510-7c36-4f3c-badd-1888ca992d6c"
      }
    }
  }
}
